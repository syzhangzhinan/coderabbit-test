{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": "..",
    "paths": {
      "~/*": ["./*"],
      "vue": ["node_modules/vue"]
    },
    "lib": ["ES2020", "DOM"]
  }
}